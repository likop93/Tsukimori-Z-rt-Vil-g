extends Node
var failures: Array[String] = []
func check(ok: bool, label: String) -> void:
    if not ok:
        failures.append(label)

func _ready() -> void:
    GameState.clear_runtime_state()
    check(GameState.day == 0,"Arrival is day zero")
    check(not GameState.set_story_time(121,"morning"),"120-day upper bound")
    check(not GameState.set_story_time(1,"unknown"),"Reject unknown period")
    for d in 120:
        var number := d+1
        check(GameState.set_story_time(number,"morning"),"Calendar advances")
        check(GameState.season() == ["spring","summer","autumn","winter"][d/30],"Season boundaries")
        GameState.set_flag("weather_anomaly")
        check(GameState.has_flag("weather_anomaly") == (number >= 30),"Weather boundary day %d" % number)
        check(not GameState.set_story_time(number-1,"night"),"No accidental rewind")
    GameState.clear_runtime_state()
    GameState.set_story_time(1,"afternoon")
    check(GameState.visit_location("school"),"First arrival")
    check(not GameState.visit_location("school"),"Duplicate visit")
    check(GameState.visited_today("school"),"Daily visit query")
    check(GameState.aff_miyako == 0 and GameState.horror_pressure == 0,"Travel grants nothing")
    var spec := {"id":"school_intro","min_day":1,"max_day":10,"periods":["afternoon"],"location":"school","requires":["met_reina"],"excludes":["closed"]}
    check(not GameState.event_available(spec),"Required character flag")
    GameState.set_flag("met_reina")
    check(GameState.complete_event(spec),"Eligible event")
    check(not GameState.complete_event(spec),"Event one-shot")
    GameState.set_story_time(2,"afternoon")
    check(not GameState.visited_today("school") and GameState.discoveries.school == 1,"Discovery outlives daily visit")
    for delay in [0,1,2,3,4,5]:
        GameState.clear_runtime_state()
        GameState.set_story_time(4,"afternoon")
        GameState.visit_location("home")
        check(not GameState.invite_mashiro(),"No early Mashiro")
        GameState.set_story_time(7,"morning")
        check(GameState.invite_mashiro(),"Day seven invitation")
        check(not GameState.invite_mashiro(),"Invitation cannot reset deadline")
        GameState.set_story_time(7+delay,"afternoon")
        GameState.visit_location("greenhouse")
        check(GameState.mashiro_visit_status() == ["tomorrow","on_time","uncertain","disappointed","disappointed","overdue"][delay],"Deadline consequence")
        check(GameState.visit_mashiro() == (delay > 0),"Next-day afternoon visit")
        check(not GameState.visit_mashiro(),"First visit one-shot")
        if delay > 0:
            var status := GameState.mashiro_visit_status()
            GameState.set_story_time(20,"afternoon")
            check(GameState.mashiro_visit_status() == status,"Completed arrival timing stays stable")
    GameState.clear_runtime_state()
    check(GameState.record_relationship_decision("tea","miyako","closer"),"Flirt recorded")
    check(not GameState.record_relationship_decision("tea","miyako","boundary"),"Decision deduplication")
    check(GameState.mashiro_route_eligible(),"Flirt does not lock Mashiro")
    check(GameState.commit_relationship("miyako"),"Explicit other commitment")
    check(not GameState.mashiro_route_eligible(),"Serious other route excludes Mashiro")
    for alignment in ["benevolent","dark"]:
        GameState.clear_runtime_state()
        check(GameState.set_harem_commitment(alignment),"Authored harem alignment")
        check(not GameState.mashiro_route_eligible(),"Both harem routes exclude Mashiro")
    GameState.clear_runtime_state()
    GameState.set_story_time(7,"morning")
    GameState.visit_location("home")
    GameState.invite_mashiro()
    GameState.set_story_time(8,"afternoon")
    GameState.visit_location("greenhouse")
    GameState.visit_mashiro()
    check(GameState.commit_relationship("mashiro"),"Exclusive commitment available after introduction")
    check(not GameState.commit_relationship("reina") and not GameState.set_harem_commitment("benevolent"),"Exclusivity works in both directions")
    check(not GameState.has_flag("true_ending") and not GameState.has_flag("miyako_transformation_revealed"),"No ending or transformation awarded")
    GameState.clear_runtime_state()
    check(GameState.visits.is_empty() and GameState.commitments.is_empty() and GameState.completed_events.is_empty() and GameState.relationship_decisions.is_empty() and GameState.mashiro_invitation_day == -1,"New game clears calendar and routes")
    print("CALENDAR: "+JSON.stringify({"passed":failures.is_empty(),"failures":failures}))
    get_tree().quit(0 if failures.is_empty() else 1)
